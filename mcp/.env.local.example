# MCP local env template
# Copy to .env.local and fill with real values. Do not commit .env.local.

# Purple MCP (SentinelOne)
PURPLEMCP_CONSOLE_BASE_URL=https://your-console.sentinelone.net
PURPLEMCP_CONSOLE_TOKEN=your_token_here

# VirusTotal MCP
VIRUSTOTAL_API_KEY=your_vt_api_key

# CISA KEV MCP
# (likely none required)

# TI Aggregator (local) provider keys
OTX_API_KEY=your_otx_key
GREYNOISE_API_KEY=your_greynoise_key
ABUSEIPDB_API_KEY=your_abuseipdb_key
ABUSECH_API_KEY=your_abusech_key
SHODAN_API_KEY=your_shodan_key
URLSCAN_API_KEY=your_urlscan_key
